{
  "id": "yaoimangaonline",
  "name": "Yaoi Manga Online",
  "type": "yaoimangaonline",
  "baseUrl": "https://yaoimangaonline.com/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[YaoiMangaOnline Scraper] \" + msg);\n        if (window.Android && window.Android.log) { window.Android.log(msg); }\n    }\n\n    function extractImgUrl(img) {\n        const cand = img.getAttribute('data-src') ||\n                   img.getAttribute('data-lazy-src') ||\n                   img.getAttribute('data-cfsrc') ||\n                   img.getAttribute('src');\n        if (!cand) return null;\n        try {\n            return new URL(cand, location.href).href;\n        } catch (e) {\n            return null;\n        }\n    }\n\n    function collectImagesFromDoc(doc, urls) {\n        const imgElements = doc.querySelectorAll('.entry-content img');\n        imgElements.forEach(img => {\n            const u = extractImgUrl(img);\n            if (u && !urls.includes(u)) {\n                urls.push(u);\n            }\n        });\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting YaoiMangaOnline Scraper...\");\n        try {\n            const urls = [];\n            collectImagesFromDoc(document, urls);\n\n            if (urls.length === 0) {\n                const tocLinks = document.querySelectorAll('.mpp-toc a');\n                if (tocLinks.length > 0) {\n                    log(\"Found \" + tocLinks.length + \" chapter links in table of contents. Fetching...\");\n                    for (const link of tocLinks) {\n                        const href = link.getAttribute('href');\n                        if (href) {\n                            try {\n                                const chUrl = new URL(href, location.href).href;\n                                log(\"Fetching chapter: \" + chUrl);\n                                const resp = await fetch(chUrl);\n                                if (resp.ok) {\n                                    const text = await resp.text();\n                                    const doc = new DOMParser().parseFromString(text, 'text/html');\n                                    collectImagesFromDoc(doc, urls);\n                                }\n                            } catch (e) {\n                                log(\"Error fetching TOC chapter: \" + e.message);\n                            }\n                        }\n                    }\n                }\n            }\n\n            if (urls.length === 0) {\n                throw new Error(\"No images found\");\n            }\n\n            log(\"Found \" + urls.length + \" images for YaoiMangaOnline!\");\n            const titleEl = document.querySelector('h1.entry-title') || document.querySelector('h1');\n            const rawTitle = titleEl ? titleEl.textContent.trim() : document.title;\n            const cleanTitle = rawTitle.split(/\\s+by\\s+/i)[0].trim();\n\n            const result = {\n                title: cleanTitle || document.title.trim(),\n                images: urls,\n                cookie: document.cookie\n            };\n\n            if (window.Android && window.Android.onImagesFound) {\n                Android.onImagesFound(JSON.stringify(result));\n            } else {\n                log(\"Result: \" + JSON.stringify(result));\n            }\n        } catch(e) {\n            log(\"YaoiMangaOnline Scraper Error: \" + e.message);\n        }\n    };\n})();"
}