{
  "id": "yaoiscan",
  "name": "YaoiScan",
  "type": "yaoiscan",
  "baseUrl": "https://yaoiscan.com/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[YaoiScan Scraper] \" + msg);\n        if (window.Android && window.Android.log) { window.Android.log(msg); }\n    }\n\n    function extractImages() {\n        const urls = [];\n        const selectors = [\n            'div.page-break img',\n            'li.blocks-gallery-item img',\n            '.reading-content img',\n            'div.reading-content img',\n            '.text-left img',\n            '#chip-page img'\n        ];\n        const imgs = document.querySelectorAll(selectors.join(', '));\n        imgs.forEach(img => {\n            let src = img.getAttribute('data-src') ||\n                      img.getAttribute('data-lazy-src') ||\n                      img.getAttribute('data-cfsrc') ||\n                      img.getAttribute('data-manga-src') ||\n                      img.getAttribute('src');\n            if (!src && img.getAttribute('srcset')) {\n                const srcset = img.getAttribute('srcset');\n                const candidates = srcset.split(',').map(s => s.trim().split(/\\s+/)[0]).filter(Boolean);\n                if (candidates.length > 0) {\n                    src = candidates[candidates.length - 1];\n                }\n            }\n            if (src) {\n                src = src.trim();\n                if (!src.includes('readerarea.svg') && !src.includes('logo') && !src.includes('avatar') && !src.includes('banner') && !src.includes('placeholder')) {\n                    try {\n                        const fullUrl = new URL(src, location.href).href;\n                        if (!urls.includes(fullUrl)) {\n                            urls.push(fullUrl);\n                        }\n                    } catch(e) {}\n                }\n            }\n        });\n\n        return urls;\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting YaoiScan Scraper...\");\n        try {\n            const imageUrls = extractImages();\n            if (imageUrls.length === 0) {\n                throw new Error(\"No images found on page\");\n            }\n\n            log(\"Found \" + imageUrls.length + \" images for YaoiScan!\");\n            const titleEl = document.querySelector('h1.entry-title') || document.querySelector('h1');\n            const rawTitle = titleEl ? titleEl.textContent.trim() : document.title;\n            const cleanTitle = rawTitle.replace(/\\s*[-–—]\\s*Yaoi\\s*Scan.*$/i, '').replace(/\\s*[-–—]\\s*YaoiScan.*$/i, '').trim();\n\n            const result = {\n                title: cleanTitle || document.title.trim(),\n                images: imageUrls,\n                cookie: document.cookie\n            };\n\n            if (window.Android && window.Android.onImagesFound) {\n                Android.onImagesFound(JSON.stringify(result));\n            } else {\n                log(\"Result: \" + JSON.stringify(result));\n            }\n        } catch(e) {\n            log(\"YaoiScan Scraper Error: \" + e.message);\n        }\n    };\n})();"
}
