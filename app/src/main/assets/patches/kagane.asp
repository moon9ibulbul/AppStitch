{
  "id": "kagane",
  "name": "Kagane",
  "type": "kagane",
  "baseUrl": "https://kagane.to/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[Kagane Scraper] \" + msg);\n        if (window.Android && window.Android.log) { window.Android.log(msg); }\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting Kagane Scraper...\");\n        try {\n            const pathSegments = location.pathname.split('/').filter(Boolean);\n            const readerIdx = pathSegments.indexOf('reader');\n            let chapterId;\n            if (readerIdx !== -1 && readerIdx + 1 < pathSegments.length) {\n                chapterId = pathSegments[readerIdx + 1];\n            } else {\n                chapterId = pathSegments[pathSegments.length - 1];\n            }\n            if (!chapterId) throw new Error(\"Could not parse chapter ID from URL\");\n\n            log(\"Fetching integrity token...\");\n            const integrityResp = await fetch('/api/integrity', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: ''\n            });\n            if (!integrityResp.ok) throw new Error(\"Integrity API returned HTTP \" + integrityResp.status);\n            const integrityData = await integrityResp.json();\n            const integrityToken = integrityData.token;\n            if (!integrityToken) throw new Error(\"No integrity token received\");\n\n            log(\"Requesting chapter pages for ID: \" + chapterId);\n            const bookUrl = '/api/v2/books/' + chapterId + '?is_datasaver=false';\n            const bookResp = await fetch(bookUrl, {\n                method: 'POST',\n                headers: {\n                    'Content-Type': 'application/json',\n                    'x-integrity-token': integrityToken\n                },\n                body: '{}'\n            });\n            if (!bookResp.ok) throw new Error(\"Book API returned HTTP \" + bookResp.status);\n            const bookData = await bookResp.json();\n\n            const accessToken = bookData.access_token;\n            let cacheUrl = bookData.cache_url || '';\n            if (cacheUrl.endsWith('/')) {\n                cacheUrl = cacheUrl.slice(0, -1);\n            }\n\n            const pages = (bookData.manifest && bookData.manifest.pages) ? bookData.manifest.pages : [];\n            if (!pages || pages.length === 0) throw new Error(\"No pages found in manifest\");\n\n            const imageUrls = pages.map(page => {\n                const pageId = page.page_id || page.pageUuid || page.id;\n                const ext = page.ext || 'jxl';\n                return cacheUrl + '/api/v2/books/page/' + chapterId + '/' + pageId + '.' + ext + '?token=' + encodeURIComponent(accessToken);\n            });\n\n            log(\"Found \" + imageUrls.length + \" images for Kagane!\");\n            const result = {\n                title: document.title.replace(/\\s*-\\s*Kagane.*$/i, '').trim() || (\"Kagane \" + chapterId),\n                images: imageUrls,\n                cookie: document.cookie\n            };\n\n            if (window.Android && window.Android.onImagesFound) {\n                Android.onImagesFound(JSON.stringify(result));\n            } else {\n                log(\"Result: \" + JSON.stringify(result));\n            }\n        } catch(e) {\n            log(\"Kagane Scraper Error: \" + e.message);\n        }\n    };\n})();"
}
