{
  "id": "xcomic",
  "name": "XCOMIC",
  "type": "xcomic",
  "baseUrl": "https://xcomic.me/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[XCOMIC Scraper] \" + msg);\n        if (window.Android && window.Android.log) { window.Android.log(msg); }\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting XCOMIC Scraper...\");\n        try {\n            const pathSegments = location.pathname.split('/').filter(Boolean);\n            const chapterId = pathSegments[pathSegments.length - 1];\n            if (!chapterId) throw new Error(\"Could not parse chapter ID from URL\");\n\n            log(\"Fetching GraphQL chapterNode for ID: \" + chapterId);\n            const queryStr = 'query($id: ID!) { get_chapterNode(id: $id) { id data { imageUrls } } }';\n            const resp = await fetch('/query/', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({\n                    query: queryStr,\n                    variables: { id: chapterId }\n                })\n            });\n\n            if (!resp.ok) throw new Error(\"GraphQL endpoint returned HTTP \" + resp.status);\n            const json = await resp.json();\n            if (!json.data || !json.data.get_chapterNode || !json.data.get_chapterNode.data) {\n                throw new Error(\"Invalid GraphQL response format\");\n            }\n\n            const rawUrls = json.data.get_chapterNode.data.imageUrls || [];\n            if (rawUrls.length === 0) throw new Error(\"No imageUrls found in chapterNode\");\n\n            const imageUrls = rawUrls.map(u => {\n                if (u.startsWith('http')) return u;\n                return location.origin + (u.startsWith('/') ? '' : '/') + u;\n            });\n\n            log(\"Found \" + imageUrls.length + \" images for XCOMIC!\");\n            const result = {\n                title: document.title.replace('- XCOMIC', '').trim(),\n                images: imageUrls,\n                cookie: document.cookie\n            };\n\n            if (window.Android && window.Android.onImagesFound) {\n                Android.onImagesFound(JSON.stringify(result));\n            } else {\n                log(\"Result: \" + JSON.stringify(result));\n            }\n        } catch(e) {\n            log(\"XCOMIC Scraper Error: \" + e.message);\n        }\n    };\n})();"
}
