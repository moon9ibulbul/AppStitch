{
  "id": "myreadingmanga",
  "name": "MyReadingManga",
  "type": "myreadingmanga",
  "baseUrl": "https://myreadingmanga.info/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[MyReadingManga Scraper] \" + msg);\n        if (window.Android && window.Android.log) { window.Android.log(msg); }\n    }\n\n    function extractImgUrl(img) {\n        const cand = img.getAttribute('data-src') ||\n                   img.getAttribute('data-cfsrc') ||\n                   img.getAttribute('src') ||\n                   img.getAttribute('data-lazy-src');\n        if (!cand) return null;\n        if (!/\\.(jpg|png|jpeg|webp)/i.test(cand)) return null;\n        try {\n            return new URL(cand, location.href).href;\n        } catch (e) {\n            return null;\n        }\n    }\n\n    function collectImagesFromDoc(doc, urls) {\n        const imgElements = doc.querySelectorAll('div.entry-content img, div.separator img');\n        imgElements.forEach(img => {\n            const u = extractImgUrl(img);\n            if (u && !urls.includes(u)) {\n                urls.push(u);\n            }\n        });\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting MyReadingManga Scraper...\");\n        try {\n            const urls = [];\n            collectImagesFromDoc(document, urls);\n\n            let maxPage = 1;\n            const pageNumLinks = document.querySelectorAll('a.page-numbers');\n            pageNumLinks.forEach(link => {\n                const num = parseInt(link.textContent.trim(), 10);\n                if (!isNaN(num) && num > maxPage) {\n                    maxPage = num;\n                }\n            });\n\n            if (maxPage > 1) {\n                log(\"Found \" + maxPage + \" pages for this post. Fetching additional pages...\");\n                const cleanPath = location.pathname.replace(/\\/(\\d+)\\/?$/, '');\n                const baseUrlPath = location.origin + (cleanPath.endsWith('/') ? cleanPath : cleanPath + '/');\n                \n                const matchPage = location.pathname.match(/\\/(\\d+)\\/?$/);\n                const currentPage = matchPage ? parseInt(matchPage[1], 10) : 1;\n\n                for (let p = 1; p <= maxPage; p++) {\n                    if (p === currentPage) continue;\n                    const pageUrl = baseUrlPath + p + '/';\n                    log(\"Fetching page \" + p + \" from \" + pageUrl);\n                    try {\n                        const resp = await fetch(pageUrl);\n                        if (resp.ok) {\n                            const text = await resp.text();\n                            const doc = new DOMParser().parseFromString(text, 'text/html');\n                            collectImagesFromDoc(doc, urls);\n                        }\n                    } catch(e) {\n                        log(\"Error fetching page \" + p + \": \" + e.message);\n                    }\n                }\n            }\n\n            if (urls.length === 0) {\n                throw new Error(\"No images found on page\");\n            }\n\n            log(\"Found \" + urls.length + \" images for MyReadingManga!\");\n            const titleEl = document.querySelector('h1') || document.querySelector('.entry-title');\n            const rawTitle = titleEl ? titleEl.textContent.trim() : document.title;\n            const cleanTitle = rawTitle.replace(/\\[[^\\]]*\\]/g, '').split('(')[0].trim();\n\n            const result = {\n                title: cleanTitle || document.title.trim(),\n                images: urls,\n                cookie: document.cookie\n            };\n\n            if (window.Android && window.Android.onImagesFound) {\n                Android.onImagesFound(JSON.stringify(result));\n            } else {\n                log(\"Result: \" + JSON.stringify(result));\n            }\n        } catch(e) {\n            log(\"MyReadingManga Scraper Error: \" + e.message);\n        }\n    };\n})();"
}