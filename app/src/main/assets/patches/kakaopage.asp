{
  "id": "kakaopage",
  "name": "KakaoPage",
  "type": "kakaopage",
  "baseUrl": "https://page.kakao.com/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[KakaoPage Scraper] \" + msg);\n        if (window.Android && window.Android.log) { window.Android.log(msg); }\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting KakaoPage Scraper...\");\n        try {\n            const pathSegments = location.pathname.split('/').filter(Boolean);\n            let seriesId = '';\n            let singleId = '';\n            for (let i = 0; i < pathSegments.length; i++) {\n                if (pathSegments[i] === 'content' && i + 1 < pathSegments.length) seriesId = pathSegments[i + 1];\n                if (pathSegments[i] === 'viewer' && i + 1 < pathSegments.length) singleId = pathSegments[i + 1];\n            }\n            if (!seriesId || !singleId) throw new Error(\"Could not parse series or single ID from URL\");\n\n            log(\"Fetching KakaoPage viewer data for series \" + seriesId + \", single \" + singleId);\n            const resp = await fetch('https://bff-page.kakao.com/api/gateway/api/v1/viewer/data', {\n                method: 'POST',\n                headers: {\n                    'Content-Type': 'application/json'\n                },\n                body: JSON.stringify({\n                    seriesId: seriesId,\n                    singleId: singleId\n                })\n            });\n            if (!resp.ok) throw new Error(\"KakaoPage viewer API returned HTTP \" + resp.status);\n            const json = await resp.json();\n            const viewerData = json.viewer_data || json.viewerData;\n            if (!viewerData || !viewerData.imageDownloadData || !viewerData.imageDownloadData.files) {\n                throw new Error(\"Invalid KakaoPage viewer data structure\");\n            }\n            const files = viewerData.imageDownloadData.files;\n            const imageUrls = files.map(f => f.secureUrl).filter(Boolean);\n            const title = (json.item && json.item.title) ? json.item.title : document.title;\n\n            const result = {\n                title: title,\n                images: imageUrls,\n                cookie: document.cookie\n            };\n\n            if (window.Android && window.Android.onImagesFound) {\n                Android.onImagesFound(JSON.stringify(result));\n            } else {\n                log(\"Result: \" + JSON.stringify(result));\n            }\n        } catch(e) {\n            log(\"KakaoPage Scraper Error: \" + e.message);\n        }\n    };\n})();"
}
