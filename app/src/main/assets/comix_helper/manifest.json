{
  "manifest_version": 3,
  "name": "Astral Comix Extraction Bridge",
  "version": "1.0.0",
  "description": "Fixes full chapter page extraction on Comix for GeckoView",
  "browser_specific_settings": {
    "gecko": {
      "id": "comix-helper@astral.stitchapp",
      "strict_min_version": "142.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "host_permissions": [
    "*://comix.to/*",
    "*://*.comix.to/*",
    "*://comix.ws/*",
    "*://*.comix.ws/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://comix.to/*",
        "*://*.comix.to/*",
        "*://comix.ws/*",
        "*://*.comix.ws/*"
      ],
      "js": ["comix_bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
