{
  "id": "yaoiscan",
  "name": "YaoiScan",
  "type": "yaoiscan",
  "baseUrl": "https://yaoiscan.fr/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[YaoiScan Scraper] \" + msg);\n        if (window.Android && window.Android.log) { window.Android.log(msg); }\n    }\n\n    function extractImages() {\n        const urls = [];\n\n        const imgs = document.querySelectorAll('#readerarea img, .reader-area img, div#readerarea p img');\n        imgs.forEach(img => {\n            const src = img.getAttribute('data-src') || img.getAttribute('src') || img.getAttribute('data-lazy-src');\n            if (src && !src.includes('readerarea.svg') && !src.includes('logo') && !urls.includes(src)) {\n                try {\n                    urls.push(new URL(src, location.href).href);\n                } catch(e) {}\n            }\n        });\n\n        if (urls.length === 0) {\n            const html = document.documentElement.innerHTML;\n            const tsMatch = html.match(/ts_reader\\.run\\((.*?)\\);/s);\n            if (tsMatch) {\n                try {\n                    const tsData = JSON.parse(tsMatch[1]);\n                    if (tsData && tsData.sources) {\n                        tsData.sources.forEach(srcObj => {\n                            if (srcObj.images && Array.isArray(srcObj.images)) {\n                                srcObj.images.forEach(imgUrl => {\n                                    if (imgUrl && !urls.includes(imgUrl)) {\n                                        urls.push(imgUrl);\n                                    }\n                                });\n                            }\n                        });\n                    }\n                } catch(e) {\n                    log(\"Error parsing ts_reader data: \" + e.message);\n                }\n            }\n        }\n\n        return urls;\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting YaoiScan Scraper...\");\n        try {\n            const imageUrls = extractImages();\n            if (imageUrls.length === 0) {\n                throw new Error(\"No images found on page\");\n            }\n\n            log(\"Found \" + imageUrls.length + \" images for YaoiScan!\");\n            const titleEl = document.querySelector('h1.entry-title') || document.querySelector('h1');\n            const rawTitle = titleEl ? titleEl.textContent.trim() : document.title;\n            const cleanTitle = rawTitle.replace(/\\s*[-–—]\\s*Yaoi\\s*Scan.*$/i, '').trim();\n\n            const result = {\n                title: cleanTitle || document.title.trim(),\n                images: imageUrls,\n                cookie: document.cookie\n            };\n\n            if (window.Android && window.Android.onImagesFound) {\n                Android.onImagesFound(JSON.stringify(result));\n            } else {\n                log(\"Result: \" + JSON.stringify(result));\n            }\n        } catch(e) {\n            log(\"YaoiScan Scraper Error: \" + e.message);\n        }\n    };\n})();"
}
