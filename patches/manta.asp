{
  "id": "manta",
  "name": "Manta",
  "type": "manta",
  "baseUrl": "https://manta.net/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[Manta Scraper] \" + msg);\n        if (window.Android && window.Android.log) {\n            window.Android.log(msg);\n        }\n    }\n\n    const EXT_HINT = /\\.jpe?g(\\?|#|$)/i;\n    const JUNK_KEYWORDS = ['cover', 'thumb', 'thumbnail', 'banner', 'poster', 'avatar', 'icon', 'badge', 'promo', 'logo', 'profile'];\n\n    const SKIP_RESOLUTIONS = [\n        { w: 720, h: 1035 },\n        { w: 720, h: 720 },\n        { w: 720, h: 336 },\n        { w: 720, h: 311 },\n        { w: 480, h: 690 },\n        { w: 480, h: 480 },\n        { w: 320, h: 320 },\n        { w: 420, h: 210 },\n        { w: 480, h: 1024 },\n        { w: 1440, h: 3072 },\n        { w: 720, h: 1536 }\n    ];\n\n    const isJpegUrl = function(u) { return EXT_HINT.test(u); };\n    const isImageContentType = function(ct) { return ct && /^image\\/(jpeg|jpg)/i.test(ct.trim()); };\n    const norm = function(u) { try { return new URL(u, location.href).href; } catch(e) { return u; } };\n\n    window._mantaState = window._mantaState || {\n        found: new Map(),\n        seqCounter: 0,\n        isHooked: false\n    };\n    const state = window._mantaState;\n\n    function isSkippedResolution(w, h) {\n        if (!w || !h) return false;\n        return SKIP_RESOLUTIONS.some(function(r) {\n            if ((r.w === w && r.h === h) || (r.w === h && r.h === w)) return true;\n            const scales = [1.5, 2, 0.5, 0.666667, 0.75];\n            for (let i = 0; i < scales.length; i++) {\n                const s = scales[i];\n                if (Math.abs(r.w * s - w) < 2 && Math.abs(r.h * s - h) < 2) return true;\n                if (Math.abs(r.w * s - h) < 2 && Math.abs(r.h * s - w) < 2) return true;\n            }\n            return false;\n        });\n    }\n\n    function isJunkUrl(u) {\n        if (!u) return false;\n        const lower = u.toLowerCase();\n        return JUNK_KEYWORDS.some(function(kw) { return lower.includes(kw); });\n    }\n\n    function shouldInclude(it) {\n        if (!isJpegUrl(it.url) && !isImageContentType(it.type)) return false;\n        if (isJunkUrl(it.url)) return false;\n\n        if (typeof it.w === 'number' && typeof it.h === 'number' && it.w > 0 && it.h > 0) {\n            return !isSkippedResolution(it.w, it.h);\n        }\n        return false;\n    }\n\n    function recordDimensionsAndPosFor(url, el) {\n        const u = norm(url);\n        const it = state.found.get(u);\n        if (!it) return;\n\n        const nw = Number(el.naturalWidth || 0);\n        const nh = Number(el.naturalHeight || 0);\n\n        if (nw > 0) it.w = nw;\n        if (nh > 0) it.h = nh;\n\n        try {\n            const rect = el.getBoundingClientRect();\n            const topY = rect.top + (window.scrollY || window.pageYOffset || 0);\n            if (topY > 0) {\n                if (it.yPos === undefined || topY < it.yPos) {\n                    it.yPos = topY;\n                }\n            }\n        } catch(e) {}\n    }\n\n    function pushFound(url, from, type, domIdx, jsonIdx, yPos) {\n        const u = norm(url);\n        if (!u) return;\n\n        if (!isJpegUrl(u) && !isImageContentType(type)) return;\n        if (isJunkUrl(u)) return;\n\n        if (!state.found.has(u)) {\n            state.found.set(u, {\n                url: u,\n                from: from || '',\n                type: type || '',\n                seq: ++state.seqCounter,\n                domIdx: typeof domIdx === 'number' ? domIdx : undefined,\n                jsonIdx: typeof jsonIdx === 'number' ? jsonIdx : undefined,\n                yPos: typeof yPos === 'number' && yPos > 0 ? yPos : undefined,\n                w: 0,\n                h: 0,\n                measured: false\n            });\n            log(\"Discovered image #\" + state.seqCounter + \": \" + u.substring(0, 60) + \"...\");\n        } else {\n            const existing = state.found.get(u);\n            if (typeof domIdx === 'number' && (existing.domIdx === undefined || domIdx < existing.domIdx)) {\n                existing.domIdx = domIdx;\n            }\n            if (typeof jsonIdx === 'number' && (existing.jsonIdx === undefined || jsonIdx < existing.jsonIdx)) {\n                existing.jsonIdx = jsonIdx;\n            }\n            if (typeof yPos === 'number' && yPos > 0) {\n                if (existing.yPos === undefined || yPos < existing.yPos) {\n                    existing.yPos = yPos;\n                }\n            }\n        }\n    }\n\n    function extractUrlsFromText(t) {\n        const urls = [];\n        const seen = new Set();\n        const fre = /(https?:\\/\\/[^\\s\"'\\\\\\)]+?\\.jpe?g(?:\\?[^\"'\\\\\\)]*)?)/gi;\n        let fm;\n        while ((fm = fre.exec(t))) {\n            const u = fm[1];\n            if (!isJunkUrl(u) && !seen.has(u)) {\n                seen.add(u);\n                urls.push(u);\n            }\n        }\n        return urls;\n    }\n\n    function scanNextData() {\n        try {\n            const el = document.getElementById('__NEXT_DATA__');\n            if (el && el.textContent) {\n                const urls = extractUrlsFromText(el.textContent);\n                urls.forEach(function(u, idx) {\n                    pushFound(u, 'next_data', '', undefined, idx);\n                });\n            }\n        } catch(e) {}\n    }\n\n    function installHooks() {\n        if (state.isHooked) return;\n        state.isHooked = true;\n\n        const origFetch = window.fetch;\n        window.fetch = async function(input, init) {\n            let reqUrl = '';\n            try { reqUrl = typeof input === 'string' ? input : (input && input.url ? input.url : ''); } catch(e) {}\n            const res = await origFetch.apply(this, arguments);\n            try {\n                const ct = res.headers.get('content-type') || '';\n                const clone = res.clone();\n                if (isImageContentType(ct)) {\n                    pushFound(reqUrl, 'fetch', ct);\n                } else if (/json|text|javascript/i.test(ct)) {\n                    clone.text().then(function(t) {\n                        extractUrlsFromText(t).forEach(function(u, idx) { pushFound(u, 'fetch-json', '', undefined, idx); });\n                    }).catch(function() {});\n                }\n            } catch(e) {}\n            return res;\n        };\n\n        const XHR = XMLHttpRequest;\n        const origOpen = XHR.prototype.open;\n        const origSend = XHR.prototype.send;\n        XHR.prototype.open = function(method, url) {\n            this.__url = url;\n            return origOpen.apply(this, arguments);\n        };\n        XHR.prototype.send = function() {\n            this.addEventListener('load', function() {\n                try {\n                    const hdr = this.getAllResponseHeaders() || '';\n                    const ctMatch = hdr.match(/^content-type:\\s*([^\\r\\n]+)/im);\n                    const ct = ctMatch ? ctMatch[1] : '';\n                    if (isImageContentType(ct)) {\n                        pushFound(this.__url, 'xhr', ct);\n                    } else if (/json|text|javascript/i.test(ct)) {\n                        const txt = typeof this.response === 'string' ? this.response : (this.responseText || '');\n                        extractUrlsFromText(txt).forEach(function(u, idx) { pushFound(u, 'xhr-json', '', undefined, idx); });\n                    }\n                } catch(e) {}\n            });\n            return origSend.apply(this, arguments);\n        };\n\n        try {\n            const po = new PerformanceObserver(function(list) {\n                for (const e of list.getEntries()) {\n                    if (e.initiatorType === 'img' && isJpegUrl(e.name)) {\n                        pushFound(e.name, 'perf', '');\n                    }\n                }\n            });\n            po.observe({ entryTypes: ['resource'] });\n        } catch(e) {}\n    }\n\n    function scanDOM() {\n        scanNextData();\n        const domImgs = Array.from(document.querySelectorAll('img'));\n        const scrollY = window.scrollY || window.pageYOffset || 0;\n\n        domImgs.forEach(function(img, idx) {\n            const s = img.currentSrc || img.src;\n            if (s && isJpegUrl(s)) {\n                let yPos = undefined;\n                try {\n                    const rect = img.getBoundingClientRect();\n                    if (rect.top || rect.bottom) yPos = rect.top + scrollY;\n                } catch(e) {}\n                pushFound(s, 'dom', '', idx, undefined, yPos);\n                recordDimensionsAndPosFor(s, img);\n            }\n        });\n\n        let srcsetIdx = domImgs.length;\n        document.querySelectorAll('source[srcset], img[srcset]').forEach(function(el) {\n            (el.getAttribute('srcset') || '').split(',').map(function(t) { return t.trim(); }).forEach(function(part) {\n                const u = part.split(/\\s+/)[0];\n                if (u && isJpegUrl(u)) {\n                    let yPos = undefined;\n                    try {\n                        const rect = el.getBoundingClientRect();\n                        if (rect.top || rect.bottom) yPos = rect.top + scrollY;\n                    } catch(e) {}\n                    pushFound(u, 'srcset', '', srcsetIdx++, undefined, yPos);\n                }\n            });\n        });\n\n        document.querySelectorAll('*').forEach(function(el) {\n            const bg = getComputedStyle(el).backgroundImage;\n            if (bg && bg.includes('url(')) {\n                const matches = bg.matchAll(/url\\([\"']?([^\"']+)[\"']?\\)/g);\n                for (const mm of matches) {\n                    if (isJpegUrl(mm[1])) {\n                        let yPos = undefined;\n                        try {\n                            const rect = el.getBoundingClientRect();\n                            if (rect.top || rect.bottom) yPos = rect.top + scrollY;\n                        } catch(e) {}\n                        pushFound(mm[1], 'css', '', undefined, undefined, yPos);\n                    }\n                }\n            }\n        });\n    }\n\n    async function autoScrollPage() {\n        log(\"Auto-scrolling page to trigger lazy loading...\");\n        const totalHeight = Math.max(\n            document.body.scrollHeight, document.documentElement.scrollHeight,\n            document.body.offsetHeight, document.documentElement.offsetHeight\n        );\n        const viewportHeight = window.innerHeight || 800;\n        const step = Math.floor(viewportHeight * 0.8);\n        \n        let currentPos = 0;\n        while (currentPos < totalHeight) {\n            currentPos += step;\n            window.scrollTo(0, currentPos);\n            scanDOM();\n            await new Promise(function(resolve) { setTimeout(resolve, 150); });\n        }\n        window.scrollTo(0, 0);\n        await new Promise(function(resolve) { setTimeout(resolve, 200); });\n        scanDOM();\n    }\n\n    installHooks();\n    scanDOM();\n    setInterval(scanDOM, 1000);\n\n    function resolveDimensions(item) {\n        return new Promise(function(resolve) {\n            if (item.w > 0 && item.h > 0) {\n                item.measured = true;\n                resolve();\n                return;\n            }\n\n            fetch(item.url, { credentials: 'omit' })\n                .then(function(res) { return res.blob(); })\n                .then(function(blob) {\n                    if (typeof createImageBitmap === 'function') {\n                        return createImageBitmap(blob).then(function(bmp) {\n                            item.w = bmp.width;\n                            item.h = bmp.height;\n                            item.measured = true;\n                            if (typeof bmp.close === 'function') bmp.close();\n                            resolve();\n                        });\n                    }\n                    const objectUrl = URL.createObjectURL(blob);\n                    const img = new Image();\n                    img.onload = function() {\n                        item.w = img.naturalWidth || 0;\n                        item.h = img.naturalHeight || 0;\n                        item.measured = true;\n                        URL.revokeObjectURL(objectUrl);\n                        resolve();\n                    };\n                    img.onerror = function() {\n                        URL.revokeObjectURL(objectUrl);\n                        resolve();\n                    };\n                    img.src = objectUrl;\n                })\n                .catch(function() {\n                    const img = new Image();\n                    img.onload = function() {\n                        item.w = img.naturalWidth || 0;\n                        item.h = img.naturalHeight || 0;\n                        item.measured = true;\n                        resolve();\n                    };\n                    img.onerror = function() {\n                        resolve();\n                    };\n                    img.src = item.url;\n                });\n\n            setTimeout(function() {\n                resolve();\n            }, 4000);\n        });\n    }\n\n    function extractTitle() {\n        let t = document.querySelector('meta[property=\"og:title\"]')?.content ||\n                document.title ||\n                'Manta Episode';\n        t = t.replace(/\\s*-\\s*Manta.*$/i, '')\n             .replace(/[\\u0000-\\u001F\\\\/:*?\"<>|]/g, \"_\")\n             .replace(/\\s+/g, \" \")\n             .trim();\n        return t || 'Manta Episode';\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting Manta Scraper...\");\n        await autoScrollPage();\n        scanDOM();\n\n        const items = Array.from(state.found.values());\n        log(\"Found \" + items.length + \" raw candidate JPG URLs. Measuring exact intrinsic pixel dimensions...\");\n\n        await Promise.all(items.map(function(it) { return resolveDimensions(it); }));\n\n        const validItems = items.filter(function(it) {\n            const keep = shouldInclude(it);\n            if (!keep && it.w > 0 && it.h > 0) {\n                log(\"Filtered junk image [\" + it.w + \"x\" + it.h + \"]: \" + it.url.substring(0, 60) + \"...\");\n            }\n            return keep;\n        }).sort(function(a, b) {\n            if (a.yPos !== undefined && b.yPos !== undefined) {\n                if (Math.abs(a.yPos - b.yPos) > 10) return a.yPos - b.yPos;\n            }\n            if (a.yPos !== undefined && b.yPos === undefined) return -1;\n            if (a.yPos === undefined && b.yPos !== undefined) return 1;\n\n            if (a.domIdx !== undefined && b.domIdx !== undefined) {\n                if (a.domIdx !== b.domIdx) return a.domIdx - b.domIdx;\n            }\n            if (a.domIdx !== undefined && b.domIdx === undefined) return -1;\n            if (a.domIdx === undefined && b.domIdx !== undefined) return 1;\n\n            if (a.jsonIdx !== undefined && b.jsonIdx !== undefined) {\n                if (a.jsonIdx !== b.jsonIdx) return a.jsonIdx - b.jsonIdx;\n            }\n            if (a.jsonIdx !== undefined && b.jsonIdx === undefined) return -1;\n            if (a.jsonIdx === undefined && b.jsonIdx !== undefined) return 1;\n\n            return a.seq - b.seq;\n        });\n\n        log(\"Filtered out trash images. Kept \" + validItems.length + \" valid chapter JPG images!\");\n\n        if (validItems.length === 0) {\n            log(\"No valid Manta chapter JPG images found.\");\n            return;\n        }\n\n        const imageUrls = validItems.map(function(it) { return it.url; });\n        const title = extractTitle();\n\n        const result = {\n            title: title,\n            images: imageUrls,\n            cookie: document.cookie\n        };\n\n        if (window.Android && window.Android.onImagesFound) {\n            Android.onImagesFound(JSON.stringify(result));\n        } else {\n            log(\"Result: \" + JSON.stringify(result));\n        }\n    };\n})();"
}