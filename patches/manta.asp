{
  "id": "manta",
  "name": "Manta",
  "type": "manta",
  "baseUrl": "https://manta.net/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[Manta Scraper] \" + msg);\n        if (window.Android && window.Android.log) {\n            window.Android.log(msg);\n        }\n    }\n\n    const EXT_HINT = /\\.jpe?g(\\?|#|$)/i;\n    const JSON_KEY_HINTS = ['url', 'src', 'image', 'imageUrl'];\n\n    const SKIP_RESOLUTIONS = [\n        { w: 720, h: 1035 },\n        { w: 720, h: 720 },\n        { w: 720, h: 336 },\n        { w: 720, h: 311 },\n        { w: 480, h: 690 },\n        { w: 480, h: 480 },\n        { w: 320, h: 320 },\n        { w: 420, h: 210 },\n        { w: 480, h: 1024 },\n        { w: 1440, h: 3072 },\n        { w: 720, h: 1536 }\n    ];\n\n    const isJpegUrl = function(u) { return EXT_HINT.test(u); };\n    const isImageContentType = function(ct) { return ct && /^image\\/(jpeg|jpg)/i.test(ct.trim()); };\n    const norm = function(u) { try { return new URL(u, location.href).href; } catch(e) { return u; } };\n\n    window._mantaState = window._mantaState || {\n        found: new Map(),\n        seqCounter: 0,\n        isHooked: false\n    };\n    const state = window._mantaState;\n\n    function isSkippedResolution(w, h) {\n        return SKIP_RESOLUTIONS.some(function(r) { return r.w === w && r.h === h; });\n    }\n\n    function shouldInclude(it) {\n        if (!isJpegUrl(it.url) && !isImageContentType(it.type)) return false;\n        if (typeof it.w === 'number' && typeof it.h === 'number' && it.w > 0 && it.h > 0) {\n            return !isSkippedResolution(it.w, it.h);\n        }\n        return true;\n    }\n\n    function recordDimensionsFor(url, el) {\n        const u = norm(url);\n        const it = state.found.get(u);\n        if (!it) return;\n\n        const w = Math.max(\n            Number(el.naturalWidth || 0),\n            Number(el.width || 0),\n            Number.parseInt(getComputedStyle(el).width) || 0\n        );\n        const h = Math.max(\n            Number(el.naturalHeight || 0),\n            Number(el.height || 0),\n            Number.parseInt(getComputedStyle(el).height) || 0\n        );\n\n        if (w > 0) it.w = Math.max(it.w || 0, w);\n        if (h > 0) it.h = Math.max(it.h || 0, h);\n    }\n\n    function pushFound(url, from, type) {\n        const u = norm(url);\n        if (!u) return;\n\n        if (!isJpegUrl(u) && !isImageContentType(type)) return;\n\n        if (!state.found.has(u)) {\n            state.found.set(u, {\n                url: u,\n                from: from || '',\n                type: type || '',\n                seq: ++state.seqCounter,\n                w: 0,\n                h: 0\n            });\n            log(\"Discovered image #\" + state.seqCounter + \": \" + u.substring(0, 60) + \"...\");\n        }\n    }\n\n    function extractUrlsFromText(t) {\n        const urls = new Set();\n        JSON_KEY_HINTS.forEach(function(key) {\n            const re = new RegExp('\"(?:' + key + ')\"\\\\s*:\\\\s*\"([^\"]+)\"', 'gi');\n            let m;\n            while ((m = re.exec(t))) {\n                if (isJpegUrl(m[1])) urls.add(m[1]);\n            }\n        });\n\n        const fre = /(https?:\\/\\/[^\\s\"'\\\\)]+?\\.jpe?g(?:\\?[^\"'\\\\)]*)?)/gi;\n        let fm;\n        while ((fm = fre.exec(t))) urls.add(fm[1]);\n\n        return Array.from(urls);\n    }\n\n    function installHooks() {\n        if (state.isHooked) return;\n        state.isHooked = true;\n\n        const origFetch = window.fetch;\n        window.fetch = async function(input, init) {\n            let reqUrl = '';\n            try { reqUrl = typeof input === 'string' ? input : (input && input.url ? input.url : ''); } catch(e) {}\n            const res = await origFetch.apply(this, arguments);\n            try {\n                const ct = res.headers.get('content-type') || '';\n                const clone = res.clone();\n                if (isImageContentType(ct)) {\n                    pushFound(reqUrl, 'fetch', ct);\n                } else if (/json|text|javascript/i.test(ct)) {\n                    clone.text().then(function(t) {\n                        extractUrlsFromText(t).forEach(function(u) { pushFound(u, 'fetch-json', ''); });\n                    }).catch(function() {});\n                }\n            } catch(e) {}\n            return res;\n        };\n\n        const XHR = XMLHttpRequest;\n        const origOpen = XHR.prototype.open;\n        const origSend = XHR.prototype.send;\n        XHR.prototype.open = function(method, url) {\n            this.__url = url;\n            return origOpen.apply(this, arguments);\n        };\n        XHR.prototype.send = function() {\n            this.addEventListener('load', function() {\n                try {\n                    const hdr = this.getAllResponseHeaders() || '';\n                    const ctMatch = hdr.match(/^content-type:\\s*([^\\r\\n]+)/im);\n                    const ct = ctMatch ? ctMatch[1] : '';\n                    if (isImageContentType(ct)) {\n                        pushFound(this.__url, 'xhr', ct);\n                    } else if (/json|text|javascript/i.test(ct)) {\n                        const txt = typeof this.response === 'string' ? this.response : (this.responseText || '');\n                        extractUrlsFromText(txt).forEach(function(u) { pushFound(u, 'xhr-json', ''); });\n                    }\n                } catch(e) {}\n            });\n            return origSend.apply(this, arguments);\n        };\n\n        try {\n            const po = new PerformanceObserver(function(list) {\n                for (const e of list.getEntries()) {\n                    if (e.initiatorType === 'img' && isJpegUrl(e.name)) {\n                        pushFound(e.name, 'perf', '');\n                    }\n                }\n            });\n            po.observe({ entryTypes: ['resource'] });\n        } catch(e) {}\n    }\n\n    function scanDOM() {\n        document.querySelectorAll('img').forEach(function(img) {\n            const s = img.currentSrc || img.src;\n            if (s && isJpegUrl(s)) {\n                pushFound(s, 'dom', '');\n                recordDimensionsFor(s, img);\n            }\n        });\n\n        document.querySelectorAll('source[srcset], img[srcset]').forEach(function(el) {\n            (el.getAttribute('srcset') || '').split(',').map(function(t) { return t.trim(); }).forEach(function(part) {\n                const u = part.split(/\\s+/)[0];\n                if (u && isJpegUrl(u)) pushFound(u, 'srcset', '');\n            });\n        });\n\n        document.querySelectorAll('*').forEach(function(el) {\n            const bg = getComputedStyle(el).backgroundImage;\n            if (bg && bg.includes('url(')) {\n                const matches = bg.matchAll(/url\\([\"']?([^\"']+)[\"']?\\)/g);\n                for (const mm of matches) {\n                    if (isJpegUrl(mm[1])) pushFound(mm[1], 'css', '');\n                }\n            }\n        });\n    }\n\n    installHooks();\n    scanDOM();\n    setInterval(scanDOM, 1500);\n\n    function resolveDimensions(item) {\n        return new Promise(function(resolve) {\n            if (item.w > 0 && item.h > 0) {\n                resolve();\n                return;\n            }\n            const img = new Image();\n            img.onload = function() {\n                item.w = img.naturalWidth || 0;\n                item.h = img.naturalHeight || 0;\n                resolve();\n            };\n            img.onerror = function() {\n                resolve();\n            };\n            img.src = item.url;\n            setTimeout(resolve, 3000);\n        });\n    }\n\n    function extractTitle() {\n        let t = document.querySelector('meta[property=\"og:title\"]')?.content ||\n                document.title ||\n                'Manta Episode';\n        t = t.replace(/\\s*-\\s*Manta.*$/i, '')\n             .replace(/[\\u0000-\\u001F\\\\/:*?\"<>|]/g, \"_\")\n             .replace(/\\s+/g, \" \")\n             .trim();\n        return t || 'Manta Episode';\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting Manta Scraper...\");\n        scanDOM();\n\n        const items = Array.from(state.found.values());\n        log(\"Found \" + items.length + \" raw JPG candidate URLs. Measuring dimensions & filtering...\");\n\n        await Promise.all(items.map(function(it) { return resolveDimensions(it); }));\n\n        const validItems = items.filter(function(it) { return shouldInclude(it); }).sort(function(a, b) { return a.seq - b.seq; });\n        log(\"Filtered out trash images. Kept \" + validItems.length + \" valid JPG images!\");\n\n        if (validItems.length === 0) {\n            log(\"No valid Manta chapter JPG images found.\");\n            return;\n        }\n\n        const imageUrls = validItems.map(function(it) { return it.url; });\n        const title = extractTitle();\n\n        const result = {\n            title: title,\n            images: imageUrls,\n            cookie: document.cookie\n        };\n\n        if (window.Android && window.Android.onImagesFound) {\n            Android.onImagesFound(JSON.stringify(result));\n        } else {\n            log(\"Result: \" + JSON.stringify(result));\n        }\n    };\n})();"
}