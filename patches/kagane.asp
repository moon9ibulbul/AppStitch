{
  "id": "kagane",
  "name": "Kagane",
  "type": "kagane",
  "baseUrl": "https://kagane.si/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[Kagane Scraper] \" + msg);\n        if (window.Android && window.Android.log) { window.Android.log(msg); }\n    }\n\n    async function getChapterId() {\n        const pathSegments = location.pathname.split('/').filter(Boolean);\n        if (pathSegments.length === 0) throw new Error(\"Could not parse chapter ID from URL\");\n\n        const readerIdx = pathSegments.indexOf('reader');\n        if (readerIdx !== -1 && readerIdx + 1 < pathSegments.length) {\n            return pathSegments[readerIdx + 1];\n        }\n\n        const seriesIdx = pathSegments.indexOf('series');\n        if (seriesIdx !== -1 && seriesIdx + 1 < pathSegments.length) {\n            const seriesId = pathSegments[seriesIdx + 1];\n            log(\"URL is a series page. Fetching books index for series: \" + seriesId);\n            const indexResp = await fetch('/api/v2/series/' + encodeURIComponent(seriesId) + '/books/index?fields=List');\n            if (!indexResp.ok) throw new Error(\"Series books index returned HTTP \" + indexResp.status);\n            const indexData = await indexResp.json();\n            const fields = indexData.fields || [];\n            const bookIdIdx = fields.indexOf('book_id');\n            const books = indexData.books || [];\n            if (books.length === 0) throw new Error(\"No chapters found in series \" + seriesId);\n            const bookRow = books[books.length - 1];\n            const resolvedId = (bookIdIdx !== -1) ? bookRow[bookIdIdx] : bookRow[0];\n            log(\"Resolved chapter ID from series index: \" + resolvedId);\n            return resolvedId;\n        }\n\n        return pathSegments[pathSegments.length - 1];\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting Kagane Scraper...\");\n        try {\n            const chapterId = await getChapterId();\n            if (!chapterId) throw new Error(\"Could not parse chapter ID from URL\");\n\n            log(\"Fetching integrity token...\");\n            const integrityResp = await fetch('/api/integrity', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: ''\n            });\n            if (!integrityResp.ok) throw new Error(\"Integrity API returned HTTP \" + integrityResp.status);\n            const integrityData = await integrityResp.json();\n            const integrityToken = integrityData.token;\n            if (!integrityToken) throw new Error(\"No integrity token received\");\n\n            log(\"Requesting chapter pages for ID: \" + chapterId);\n            const bookUrl = '/api/v2/books/' + encodeURIComponent(chapterId) + '?intent=Read&is_datasaver=false';\n            const bookResp = await fetch(bookUrl, {\n                method: 'POST',\n                headers: {\n                    'Content-Type': 'application/json',\n                    'x-integrity-token': integrityToken\n                },\n                body: '{}'\n            });\n            if (!bookResp.ok) throw new Error(\"Book API returned HTTP \" + bookResp.status);\n            const bookData = await bookResp.json();\n\n            const accessToken = bookData.access_token;\n            const cacheUrl = bookData.cache_url;\n            const pages = (bookData.manifest && bookData.manifest.pages) ? bookData.manifest.pages : [];\n\n            if (!pages || pages.length === 0) throw new Error(\"No pages found in manifest\");\n\n            const imageUrls = pages.map(page => {\n                const ext = page.ext || 'jxl';\n                return cacheUrl + '/api/v2/books/page/' + encodeURIComponent(chapterId) + '/' + encodeURIComponent(page.page_id) + '.' + ext + '?token=' + encodeURIComponent(accessToken);\n            });\n\n            log(\"Found \" + imageUrls.length + \" images for Kagane!\");\n            const result = {\n                title: document.title.replace(/- Kagane$/i, '').trim(),\n                images: imageUrls,\n                cookie: document.cookie\n            };\n\n            if (window.Android && window.Android.onImagesFound) {\n                Android.onImagesFound(JSON.stringify(result));\n            } else {\n                log(\"Result: \" + JSON.stringify(result));\n            }\n        } catch(e) {\n            log(\"Kagane Scraper Error: \" + e.message);\n        }\n    };\n})();"
}
