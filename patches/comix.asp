{
  "id": "comix",
  "name": "Comix",
  "type": "comix",
  "baseUrl": "https://comix.to/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[Comix Scraper] \" + msg);\n        if (typeof window !== \"undefined\" && window.Android && window.Android.log) {\n            window.Android.log(msg);\n        }\n    }\n\n    function extractPagesFromObject(obj, depth) {\n        if (!obj || depth > 8) return null;\n\n        if (typeof obj === \"object\") {\n            if (Array.isArray(obj.items) && obj.items.length > 0) {\n                const first = obj.items[0];\n                if (typeof first === \"string\" || (first && typeof first === \"object\" && (first.url || first.src))) {\n                    return obj;\n                }\n            }\n            if (obj.pages && Array.isArray(obj.pages.items) && obj.pages.items.length > 0) {\n                const first = obj.pages.items[0];\n                if (typeof first === \"string\" || (first && typeof first === \"object\" && (first.url || first.src))) {\n                    return obj.pages;\n                }\n            }\n        }\n\n        if (typeof obj === \"object\") {\n            const keys = Object.keys(obj);\n            for (let i = 0; i < keys.length; i++) {\n                const key = keys[i];\n                if (key === \"window\" || key === \"document\" || key === \"parent\") continue;\n                try {\n                    const res = extractPagesFromObject(obj[key], depth + 1);\n                    if (res) return res;\n                } catch (e) {}\n            }\n        }\n        return null;\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting Comix Scraper...\");\n        try {\n            let pages = null;\n\n            const payloadVars = [window.__comixPagePayload, window.__NEXT_DATA__, window.__NUXT__, window.pageData, window.__INITIAL_STATE__];\n            for (let i = 0; i < payloadVars.length; i++) {\n                const pv = payloadVars[i];\n                if (!pv) continue;\n                let parsed = pv;\n                if (typeof pv === \"string\") {\n                    try { parsed = JSON.parse(pv); } catch(e) {}\n                }\n                pages = extractPagesFromObject(parsed, 0);\n                if (pages) break;\n            }\n\n            if (!pages) {\n                const scripts = Array.from(document.querySelectorAll(\"script#initial-data, script#__NEXT_DATA__, script[type='application/json'], script:not([src])\"));\n                for (let i = 0; i < scripts.length; i++) {\n                    const script = scripts[i];\n                    if (!script.textContent) continue;\n                    try {\n                        const parsed = JSON.parse(script.textContent);\n                        pages = extractPagesFromObject(parsed, 0);\n                        if (pages) break;\n                    } catch (e) {\n                        const jsonMatch = script.textContent.match(/(\\{[\\s\\S]*\"items\"[\\s\\S]*\\})/);\n                        if (jsonMatch) {\n                            try {\n                                const parsed = JSON.parse(jsonMatch[1]);\n                                pages = extractPagesFromObject(parsed, 0);\n                                if (pages) break;\n                            } catch (e2) {}\n                        }\n                    }\n                }\n            }\n\n            if (!pages) {\n                const imgElems = Array.from(document.querySelectorAll(\"img\")).filter(img => {\n                    const src = img.src || img.getAttribute(\"data-src\") || \"\";\n                    return src && (src.includes(\"/episodes/\") || src.includes(\"/chapters/\") || src.includes(\"/pages/\") || src.includes(\"comix\") || src.includes(\"v3\"));\n                });\n                if (imgElems.length > 0) {\n                    pages = {\n                        baseUrl: \"\",\n                        items: imgElems.map(img => ({ url: img.src || img.getAttribute(\"data-src\") }))\n                    };\n                }\n            }\n\n            if (!pages) {\n                throw new Error(\"Could not extract pages from page state. Ensure chapter is loaded.\");\n            }\n\n            const base = (pages.baseUrl || \"\").replace(/\\/+$/, \"\");\n            const items = pages.items || (Array.isArray(pages) ? pages : []);\n            if (items.length === 0) throw new Error(\"Pages items array is empty\");\n\n            const imageUrls = items.map((img, index) => {\n                let rawUrl = typeof img === \"string\" ? img : (img.url || img.src || \"\");\n                let full = rawUrl.startsWith(\"http\") ? rawUrl : (base ? base + \"/\" + rawUrl.replace(/^\\/+/, \"\") : rawUrl);\n                const isV3 = (typeof img === \"object\" && img.s === 1) || full.includes(\"?v3\");\n                const isLegacyScramble = !isV3 && ((index + 1) % 4 === 0);\n                if (isV3) {\n                    if (!full.includes(\"v3\")) {\n                        full += (full.includes(\"?\") ? \"&v3\" : \"?v3\");\n                    }\n                } else if (isLegacyScramble) {\n                    full += \"#scrambled\";\n                }\n                return full;\n            });\n\n            log(\"Found \" + imageUrls.length + \" images for Comix!\");\n            const docTitle = (typeof document !== \"undefined\" && document.title ? document.title : \"\").replace(\"- Comix\", \"\").trim();\n            const result = {\n                title: docTitle || \"Comix Chapter\",\n                images: imageUrls,\n                cookie: (typeof document !== \"undefined\" && document.cookie) ? document.cookie : \"\"\n            };\n\n            if (typeof window !== \"undefined\" && window.Android && window.Android.onImagesFound) {\n                window.Android.onImagesFound(JSON.stringify(result));\n            } else {\n                log(\"Result: \" + JSON.stringify(result));\n            }\n        } catch(e) {\n            log(\"Comix Scraper Error: \" + e.message);\n        }\n    };\n})();"
}
