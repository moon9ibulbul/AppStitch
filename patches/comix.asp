{
  "id": "comix",
  "name": "Comix",
  "type": "comix",
  "baseUrl": "https://comix.to/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[Comix Scraper] \" + msg);\n        if (window.Android && window.Android.log) { window.Android.log(msg); }\n    }\n\n    function findPagesInQueries(queries) {\n        if (!queries) return null;\n        const vals = Object.values(queries);\n        for (let i = 0; i < vals.length; i++) {\n            const q = vals[i];\n            if (q && q.result && q.result.pages) return q.result.pages;\n            if (q && q.state && q.state.data && q.state.data.result && q.state.data.result.pages) return q.state.data.result.pages;\n        }\n        return null;\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting Comix Scraper...\");\n        try {\n            let pages = null;\n\n            if (window.__comixPagePayload) {\n                try {\n                    const parsed = JSON.parse(window.__comixPagePayload);\n                    if (parsed && parsed.result && parsed.result.pages) pages = parsed.result.pages;\n                } catch (e) {}\n            }\n\n            if (!pages) {\n                const initialDataElem = document.querySelector('script#initial-data');\n                if (initialDataElem && initialDataElem.textContent) {\n                    try {\n                        const parsed = JSON.parse(initialDataElem.textContent);\n                        pages = findPagesInQueries(parsed.queries);\n                    } catch (e) {}\n                }\n            }\n\n            if (!pages) {\n                throw new Error(\"Could not extract pages from page state. Ensure chapter is loaded.\");\n            }\n\n            const base = (pages.baseUrl || '').replace(/\\/+$/, '');\n            const items = pages.items || [];\n            if (items.length === 0) throw new Error(\"Pages items array is empty\");\n\n            const imageUrls = items.map((img, index) => {\n                let full = img.url.startsWith('http') ? img.url : base + '/' + img.url.replace(/^\\/+/, '');\n                const isV3 = img.s === 1 || full.includes('?v3');\n                const isLegacyScramble = !isV3 && ((index + 1) % 4 === 0);\n                if (isV3) {\n                    if (!full.includes('v3')) {\n                        full += (full.includes('?') ? '&v3' : '?v3');\n                    }\n                } else if (isLegacyScramble) {\n                    full += '#scrambled';\n                }\n                return full;\n            });\n\n            log(\"Found \" + imageUrls.length + \" images for Comix!\");\n            const result = {\n                title: document.title.replace('- Comix', '').trim(),\n                images: imageUrls,\n                cookie: document.cookie\n            };\n\n            if (window.Android && window.Android.onImagesFound) {\n                Android.onImagesFound(JSON.stringify(result));\n            } else {\n                log(\"Result: \" + JSON.stringify(result));\n            }\n        } catch(e) {\n            log(\"Comix Scraper Error: \" + e.message);\n        }\n    };\n})();"
}
