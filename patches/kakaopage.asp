{
  "id": "kakaopage",
  "name": "Kakaopage",
  "type": "kakaopage",
  "baseUrl": "https://page.kakao.com/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[Kakaopage Scraper] \" + msg);\n        if (window.Android && window.Android.log) { window.Android.log(msg); }\n    }\n\n    function extractFilesFromRestAPI(jsonObj) {\n        try {\n            if (!jsonObj) return null;\n            let title = null;\n            if (jsonObj.item && jsonObj.item.title) {\n                title = jsonObj.item.title;\n            }\n            const viewerData = jsonObj.viewer_data || jsonObj.viewerData;\n            if (viewerData && viewerData.type === 'ImageViewerData' && viewerData.imageDownloadData && viewerData.imageDownloadData.files) {\n                const files = viewerData.imageDownloadData.files.slice().sort((a, b) => Number(a.no) - Number(b.no));\n                const imageUrls = files.map(f => f.secureUrl).filter(Boolean);\n                return { title, images: imageUrls };\n            }\n            return null;\n        } catch (err) {\n            log(\"Error extracting files: \" + err.message);\n            return null;\n        }\n    }\n\n    function processResponseText(text) {\n        if (!text) return;\n        if (text.indexOf('\"viewer_data\"') === -1 && text.indexOf('\"viewerData\"') === -1 && text.indexOf('\"imageDownloadData\"') === -1) {\n            return;\n        }\n        try {\n            const obj = JSON.parse(text);\n            const res = extractFilesFromRestAPI(obj);\n            if (res && res.images && res.images.length > 0) {\n                const title = res.title || document.title.replace('- 카카오페이지', '').replace('카카오페이지', '').trim();\n                log(\"Found \" + res.images.length + \" images for \" + title);\n                const result = {\n                    title: title || 'Kakaopage',\n                    images: res.images,\n                    cookie: document.cookie\n                };\n                if (window.Android && window.Android.onImagesFound) {\n                    window.Android.onImagesFound(JSON.stringify(result));\n                }\n            }\n        } catch(e) {\n            log(\"Error parsing response: \" + e.message);\n        }\n    }\n\n    const BFF_HOST = 'bff-page.kakao.com';\n    const API_PATH = '/api/gateway/api/v1/viewer/data';\n\n    if (!window._kakaoFetchHooked) {\n        window._kakaoFetchHooked = true;\n        const _fetch = window.fetch;\n        window.fetch = async function(input, init) {\n            try {\n                const url = (typeof input === 'string') ? input : (input?.url || '');\n                const isTarget = url.includes(BFF_HOST) && url.includes(API_PATH);\n                const resp = await _fetch.apply(this, arguments);\n                if (isTarget) {\n                    resp.clone().text().then(processResponseText).catch(()=>{});\n                }\n                return resp;\n            } catch (e) {\n                return _fetch.apply(this, arguments);\n            }\n        };\n    }\n\n    if (!window._kakaoXhrHooked) {\n        window._kakaoXhrHooked = true;\n        const origOpen = XMLHttpRequest.prototype.open;\n        const origSend = XMLHttpRequest.prototype.send;\n        XMLHttpRequest.prototype.open = function(method, url) {\n            this._kakaoTarget = (typeof url === 'string' && url.includes(BFF_HOST) && url.includes(API_PATH));\n            return origOpen.apply(this, arguments);\n        };\n        XMLHttpRequest.prototype.send = function() {\n            if (this._kakaoTarget) {\n                this.addEventListener('readystatechange', function() {\n                    try {\n                        if (this.readyState === 4 && (this.status >= 200 && this.status < 300)) {\n                            processResponseText(this.responseText);\n                        }\n                    } catch {}\n                });\n            }\n            return origSend.apply(this, arguments);\n        };\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting Kakaopage Scraper...\");\n    };\n})();"
}
