{
  "id": "mangago",
  "name": "Mangago",
  "type": "mangago",
  "baseUrl": "https://www.mangago.me/",
  "script": "(function() {\n    'use strict';\n\n    function log(msg) {\n        console.log(\"[Mangago Scraper] \" + msg);\n        if (window.Android && window.Android.log) { window.Android.log(msg); }\n    }\n\n    const loadCryptoJS = () => {\n        return new Promise((resolve, reject) => {\n            if (typeof CryptoJS !== 'undefined') { resolve(); return; }\n            const script = document.createElement('script');\n            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js';\n            script.onload = () => resolve();\n            script.onerror = () => reject(new Error('Failed to load CryptoJS'));\n            document.head.appendChild(script);\n        });\n    };\n\n    function deobfuscateSoJsonV4(jsf) {\n        if (!jsf || !jsf.startsWith(\"['sojson.v4']\")) return jsf;\n        try {\n            const sub = jsf.substring(240, jsf.length - 59);\n            const args = sub.split(/[a-zA-Z]+/);\n            return args.map(c => String.fromCharCode(parseInt(c, 10))).join('');\n        } catch (e) {\n            log(\"deobfuscate error: \" + e.message);\n            return jsf;\n        }\n    }\n\n    function findHexVariable(input, varName) {\n        const reg = new RegExp('var\\\\s+' + varName + '\\\\s*=\\\\s*CryptoJS\\\\.enc\\\\.Hex\\\\.parse\\\\(\"([0-9a-zA-Z]+)\"\\\\)');\n        const m = input.match(reg);\n        return m ? m[1] : '';\n    }\n\n    function unscrambleImageList(imageList, js) {\n        let result = imageList;\n        try {\n            const matches = [...js.matchAll(/str\\.charAt\\(\\s*(\\d+)\\s*\\)/g)];\n            const keyLocations = [...new Set(matches.map(m => parseInt(m[1], 10)))];\n            if (keyLocations.length === 0) return result;\n\n            const keys = [];\n            for (let i = 0; i < keyLocations.length; i++) {\n                const loc = keyLocations[i];\n                const ch = result.charAt(loc);\n                const num = parseInt(ch, 10);\n                if (isNaN(num)) return imageList;\n                keys.push(num);\n            }\n\n            keyLocations.forEach((location, index) => {\n                const pos = location - index;\n                result = result.slice(0, pos) + result.slice(pos + 1);\n            });\n\n            const reversedKeys = keys.slice().reverse();\n            reversedKeys.forEach(key => {\n                let resArr = result.split('');\n                for (let index = resArr.length - 1; index >= key; index--) {\n                    if (index % 2 !== 0) {\n                        const temp = resArr[index - key];\n                        resArr[index - key] = resArr[index];\n                        resArr[index] = temp;\n                    }\n                }\n                result = resArr.join('');\n            });\n        } catch (e) {\n            log(\"unscrambleImageList error: \" + e.message);\n            return imageList;\n        }\n        return result;\n    }\n\n    function getDescramblerScript(chapterJs) {\n        if (!chapterJs.includes(\"var renImg = function(img,width,height,id){\")) return null;\n        let part = chapterJs.split(\"var renImg = function(img,width,height,id){\")[1];\n        part = part.split(\"key = key.split(\")[0];\n        const jsFilters = [\"jQuery\", \"document\", \"getContext\", \"toDataURL\", \"getImageData\", \"width\", \"height\"];\n        const lines = part.split(\"\\n\").filter(line => !jsFilters.some(f => line.includes(f)));\n        return lines.join(\"\\n\").replace(/img\\.src/g, \"url\");\n    }\n\n    window.runScraper = async function() {\n        log(\"Starting Mangago Scraper...\");\n        try {\n            await loadCryptoJS();\n\n            const html = document.documentElement.innerHTML;\n            const imgsrcsMatch = html.match(/var\\s+imgsrcs\\s*=\\s*['\"]([a-zA-Z0-9+=/]+)['\"]/);\n            if (!imgsrcsMatch) throw new Error(\"Could not find imgsrcs in page\");\n            const encryptedImgsrcs = imgsrcsMatch[1];\n\n            const scriptElem = document.querySelector('script[src*=\"chapter.js\"]');\n            if (!scriptElem) throw new Error(\"Could not find chapter.js script tag\");\n            const chapterJsUrl = scriptElem.src;\n\n            log(\"Fetching chapter.js from \" + chapterJsUrl);\n            let chapterJsRaw = \"\";\n            if (window.Android && window.Android.fetchUrl) {\n                chapterJsRaw = window.Android.fetchUrl(chapterJsUrl);\n            } else {\n                const resp = await fetch(chapterJsUrl);\n                chapterJsRaw = await resp.text();\n            }\n\n            const chapterJs = deobfuscateSoJsonV4(chapterJsRaw);\n\n            const keyHexStr = findHexVariable(chapterJs, \"key\");\n            const ivHexStr = findHexVariable(chapterJs, \"iv\");\n\n            const colsMatch = chapterJs.match(/var\\s*widthnum\\s*=\\s*heightnum\\s*=\\s*(\\d+);/);\n            const cols = colsMatch ? parseInt(colsMatch[1], 10) : 2;\n\n            log(\"Key: \" + keyHexStr + \", IV: \" + ivHexStr + \", Cols: \" + cols);\n\n            const keyHex = CryptoJS.enc.Hex.parse(keyHexStr);\n            const ivHex = CryptoJS.enc.Hex.parse(ivHexStr);\n            const decrypted = CryptoJS.AES.decrypt(encryptedImgsrcs, keyHex, {\n                iv: ivHex,\n                mode: CryptoJS.mode.CBC,\n                padding: CryptoJS.pad.ZeroPadding\n            });\n            let imageListStr = decrypted.toString(CryptoJS.enc.Utf8);\n\n            imageListStr = unscrambleImageList(imageListStr, chapterJs);\n\n            const keyScriptBody = getDescramblerScript(chapterJs);\n            let getDescramblingKeyFn = null;\n            if (keyScriptBody) {\n                getDescramblingKeyFn = new Function('url', keyScriptBody + '\\nreturn key;');\n            }\n\n            const urls = imageListStr.split(\",\");\n            const finalImages = [];\n            for (let i = 0; i < urls.length; i++) {\n                let u = urls[i].trim();\n                if (!u) continue;\n                if (getDescramblingKeyFn) {\n                    try {\n                        const descKey = getDescramblingKeyFn(u);\n                        if (descKey && descKey.includes(\"a\")) {\n                            const parts = descKey.split(\"a\");\n                            if (parts.length === cols * cols) {\n                                let isSeq = true;\n                                for (let k = 0; k < parts.length; k++) {\n                                    if (parseInt(parts[k], 10) !== k) { isSeq = false; break; }\n                                }\n                                if (!isSeq) {\n                                    u += \"#desckey=\" + encodeURIComponent(descKey) + \"&cols=\" + cols;\n                                }\n                            }\n                        }\n                    } catch (e) {\n                        log(\"Error descrambling key for image \" + i + \": \" + e.message);\n                    }\n                }\n                finalImages.push(u);\n            }\n\n            log(\"Found \" + finalImages.length + \" images for Mangago!\");\n\n            const title = document.title.replace(\"- Read Manga Online Free\", \"\").trim();\n            const result = {\n                title: title,\n                images: finalImages,\n                cookie: document.cookie\n            };\n\n            if (window.Android && window.Android.onImagesFound) {\n                Android.onImagesFound(JSON.stringify(result));\n            } else {\n                log(\"Result: \" + JSON.stringify(result));\n            }\n        } catch(e) {\n            log(\"Mangago Scraper Error: \" + e.message);\n        }\n    };\n})();"
}